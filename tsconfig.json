{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Workspace aliases */
    "baseUrl": ".",
    "paths": {
      "@mailcopilot/types": ["./packages/types/index.ts"],
      "@mailcopilot/core": ["./packages/core/index.ts"],
      "@mailcopilot/core/*": ["./packages/core/*"]
    },

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src", "electron", "packages"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
