{
  "name": "mailcopilot",
  "private": true,
  "license": "AGPL-3.0-only",
  "version": "1.24.0",
  "description": "MailCopilot — современный кроссплатформенный почтовый клиент на Electron + React + TypeScript.",
  "author": {
    "name": "MailCopilot Team",
    "email": "team@mailcopilot.io"
  },
  "homepage": "https://github.com/mailcopilot/mailcopilot",
  "repository": {
    "type": "git",
    "url": "https://github.com/mailcopilot/mailcopilot.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.14.0"
  },
  "main": "dist-electron/main.js",
  "scripts": {
    "postinstall": "electron-builder install-app-deps",
    "dev": "vite",
    "build": "tsc && vite build && electron-builder",
    "build:linux": "tsc && vite build && electron-builder --linux appimage deb",
    "build:linux:rpm": "tsc && vite build && electron-builder --linux rpm",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "check:telemetry": "node scripts/check-telemetry-schema.mjs",
    "check:agents": "node scripts/check-agents.mjs",
    "check:mirror-exclude": "node scripts/check-mirror-exclude.mjs",
    "check:mirror-export": "node scripts/check-mirror-export.mjs",
    "check:audit-expiry": "node scripts/check-audit-expiry.mjs",
    "test:scripts": "node --test \"scripts/*.test.mjs\"",
    "gen:telemetry-docs": "node scripts/gen-telemetry-docs.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "preview": "vite preview",
    "test": "vitest --run --passWithNoTests",
    "test:db": "node scripts/run-native-tests.mjs db",
    "test:all": "node scripts/run-native-tests.mjs all",
    "audit": "npx audit-ci@7 --config .audit-ci.json",
    "audit:prod": "npx audit-ci@7 --config .audit-ci.json --skip-dev",
    "e2e": "vite build --mode e2e && electron-builder install-app-deps && playwright test",
    "e2e:bg": "xvfb-run -a npm run e2e",
    "demo:video": "vite build --mode e2e && electron-builder install-app-deps && playwright test tests/e2e/demo-video.spec.ts",
    "demo:oauth": "vite build && electron-builder install-app-deps && playwright test tests/e2e/demo-oauth.spec.ts",
    "test:integration": "vitest --run --config vitest.integration.ts",
    "format": "prettier -w .",
    "prepare": "husky"
  },
  "overrides": {
    "@xmldom/xmldom": "^0.8.13"
  },
  "dependencies": {
    "@ai-sdk/mcp": "^1.0.21",
    "@ai-sdk/openai-compatible": "^2.0.30",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@napi-rs/canvas": "^0.1.92",
    "ai": "^6.0.90",
    "better-sqlite3": "^12.6.2",
    "ical.js": "^2.2.1",
    "imapflow": "^1.0.193",
    "keytar": "^7.9.0",
    "nodemailer": "^9.0.1",
    "pdfjs-dist": "^5.4.624"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.39",
    "@commitlint/cli": "^20.4.1",
    "@commitlint/config-conventional": "^20.4.1",
    "@playwright/test": "^1.54.2",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/gitlab": "^13.3.0",
    "@semantic-release/npm": "^13.1.4",
    "@sentry/node": "^10.38.0",
    "@sentry/react": "^10.38.0",
    "@sentry/vite-plugin": "^4.9.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/dompurify": "^3.0.5",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^24.2.1",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/coverage-v8": "^3.2.4",
    "dompurify": "^3.2.6",
    "dotenv": "^17.3.1",
    "electron": "^40.4.0",
    "electron-builder": "^26.7.0",
    "electron-log": "^5.4.3",
    "electron-store": "^10.1.0",
    "electron-updater": "^6.6.2",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "fast-xml-parser": "^5.5.8",
    "husky": "^9.1.7",
    "i18next": "^25.8.4",
    "jsdom": "^25.0.1",
    "lucide-react": "^0.563.0",
    "mailparser": "^3.7.4",
    "prettier": "^3.6.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^16.5.4",
    "react-markdown": "^10.1.0",
    "react-virtuoso": "^4.13.0",
    "remark-gfm": "^4.0.1",
    "semantic-release": "^25.0.3",
    "typescript": "^5.2.2",
    "undici": "^7.24.5",
    "vite": "^7.3.1",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.5",
    "vitest": "^3.2.4",
    "zod": "^4.0.15"
  }
}
