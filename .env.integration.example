# ===== MailCopilot AI Agent Integration Tests =====
# Copy to .env.integration and fill in values.
# These tests run real AI providers against a seeded SQLite database.
# They are NOT part of the regular `npm test` suite.

# Set to "1" to enable integration tests (skipped otherwise)
INTEG_ENABLED=1

# === IMAP/SMTP test accounts (reserved for future mail integration tests) ===
INTEG_IMAP_HOST=imap.example.com
INTEG_IMAP_PORT=993
INTEG_SMTP_HOST=smtp.example.com
INTEG_SMTP_PORT=587
INTEG_EMAIL1=test1@example.com
INTEG_PASS1=
INTEG_EMAIL2=test2@example.com
INTEG_PASS2=

# === AI Providers ===

# Anthropic API (Claude Agent SDK path)
# Requires: the `claude` CLI installed (the SDK drives it) + your own API key.
# The consumer-subscription provider was removed in §2.212 — Anthropic's
# Consumer Terms allow Free/Pro/Max credentials only in Claude Code and
# Claude.ai, so a third-party client must use an API key.
INTEG_ANTHROPIC_API_KEY=sk-ant-...

# OpenAI API
INTEG_OPENAI_API_KEY=sk-...
# Model (default: gpt-4o-mini)
INTEG_OPENAI_MODEL=gpt-4o-mini
# Optional: custom OpenAI-compatible base URL (OpenRouter, LiteLLM, etc.)
# INTEG_OPENAI_BASE_URL=https://api.openai.com
